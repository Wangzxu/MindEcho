# Flask / FastAPI 运行配置
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=mindecho-secret-key-change-me-in-production

# MySQL 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root_password
MYSQL_DB=mindecho

# 向量数据库配置
CHROMA_PERSIST_DIRECTORY=instance/chroma_db

# 硅基流动 API 配置 (SiliconFlow)
# 申请地址: https://siliconflow.cn/
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 大模型与嵌入模型配置
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
SIMPLE_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
COMPLEX_LLM_MODEL=deepseek-ai/DeepSeek-V3
SUMMARY_LLM_MODEL=deepseek-ai/DeepSeek-R1

# JWT 鉴权配置
JWT_SECRET_KEY=mindecho-jwt-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
